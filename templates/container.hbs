<div class="cl-cont">
  <header class="cl-cont-head">
    <img src="{{actor.img}}" alt="" data-edit="img" {{#if editable}}data-action="editImage"{{/if}}>
    <div class="cl-cont-title">
      <input type="text" name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}>
      <small>{{localize "CLOOT.Container.Type"}}</small>
    </div>
    {{#if isGM}}
    <div class="cl-cont-tools">
      <button type="button" data-action="editTable"><i class="fa-solid fa-dice"></i> {{localize "CLOOT.Menu.Loottable"}}{{#if hasTable}} ✓{{/if}}</button>
      <button type="button" data-action="playersOwn" class="{{#if playersOwn}}active{{/if}}"><i class="fa-solid {{#if playersOwn}}fa-lock-open{{else}}fa-lock{{/if}}"></i> {{localize "CLOOT.Container.PlayersOwn"}}: {{#if playersOwn}}{{localize "CLOOT.On"}}{{else}}{{localize "CLOOT.Off"}}{{/if}}</button>
      <button type="button" data-action="editLock"><i class="fa-solid fa-lock"></i> {{localize "CLOOT.Menu.Lock"}}</button>
    </div>
    {{/if}}
  </header>

  <p class="hint">{{localize "CLOOT.Container.Hint"}}</p>

  <div class="form-group">
    <label>{{localize "CLOOT.Container.Style"}}</label>
    <div class="form-fields">
      <select name="system.style" {{#unless editable}}disabled{{/unless}}>
        {{#each styles}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </div>
  </div>

  <div class="form-group stacked">
    <label>{{localize "CLOOT.Container.Description"}}</label>
    <textarea name="system.description" rows="3" {{#unless editable}}disabled{{/unless}}>{{system.description}}</textarea>
  </div>

  <div class="cl-cont-coins">
    {{#each coins}}
    <label><img src="modules/corpse-loot/assets/coin-{{key}}.svg" alt=""><input type="number" min="0" step="1" name="system.currency.{{key}}" value="{{value}}"><span>{{label}}</span></label>
    {{/each}}
  </div>

  {{#if editable}}<div class="cl-cont-stack"><button type="button" data-action="mergeStacks"><i class="fa-solid fa-layer-group"></i> {{localize "CLOOT.Container.Merge"}}</button></div>{{/if}}
  <ul class="cl-cont-items" data-drop>
    {{#each items}}
    <li>
      <img src="{{img}}" alt=""><span class="n">{{name}}</span>
      {{#if hasQty}}
      {{#if ../editable}}
      <span class="cl-qtybox">
        <button type="button" class="cl-qbtn" data-action="qtyMinus" data-item-id="{{id}}" data-tooltip="CLOOT.Container.Minus"><i class="fa-solid fa-minus"></i></button>
        <input type="number" class="cl-qty" data-item-id="{{id}}" min="1" step="1" value="{{qty}}">
        <button type="button" class="cl-qbtn" data-action="qtyPlus" data-item-id="{{id}}" data-tooltip="CLOOT.Container.Plus"><i class="fa-solid fa-plus"></i></button>
      </span>
      {{else}}<em class="cl-qtyview">×{{qty}}</em>{{/if}}
      {{/if}}
      {{#if ../editable}}<button type="button" data-action="removeItem" data-item-id="{{id}}" data-tooltip="CLOOT.Table.Remove"><i class="fa-solid fa-trash"></i></button>{{/if}}
    </li>
    {{/each}}
    <li class="cl-cont-drop"><i class="fa-solid fa-plus"></i> {{localize "CLOOT.Container.DropHint"}}</li>
  </ul>
</div>
